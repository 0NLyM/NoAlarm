<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" android:required="true" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <!--
          Riguarda solo il meccanismo di Play Store per l'installazione automatica
          abbinata al telefono, non la logica dell'app (che infatti resta una
          companion: si appoggia al telefono per sapere quando suonare, non ha una
          sua copia delle sveglie ne' le programma da solo). Con "false" alcuni
          launcher Wear OS (incluso quello di Ticwatch/Mobvoi) nascondono dal
          drawer un'app sideloaded perche' non risulta abbinata tramite quel
          meccanismo, anche se e' installata per davvero: "true" la rende visibile
          subito come qualunque altra app sideload.
        -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.DeviceDefault" />

        <service
            android:name=".RingListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/noalarm" />
            </intent-filter>
        </service>

    </application>
</manifest>
